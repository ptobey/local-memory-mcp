# Optional environment variables used by auth flows.
# Primary runtime settings are still read from config.json.

# Bearer mode (when MCP_AUTH_MODE="bearer" in config.json)
MCP_BEARER_TOKEN=

# OAuth mode (when MCP_AUTH_MODE="oauth" in config.json)
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
MCP_OAUTH_TOKEN_TTL_SECONDS=2592000

# Optional SSE bind controls (run_mcp_v5_sse_actions.py)
MCP_BIND_HOST=127.0.0.1
MCP_BIND_PORT=8000
